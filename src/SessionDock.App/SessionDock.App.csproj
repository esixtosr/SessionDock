<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SessionDock</AssemblyName>
    <RootNamespace>SessionDock.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pin bundled runtimes without applying that version to the Windows SDK projection pack. -->
    <KnownFrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WPF;Microsoft.WindowsDesktop.App.WindowsForms" DefaultRuntimeFrameworkVersion="10.0.13" LatestRuntimeFrameworkVersion="10.0.13" />
    <ProjectReference Include="../SessionDock.Core/SessionDock.Core.csproj" />
    <ProjectReference Include="../SessionDock.Infrastructure/SessionDock.Infrastructure.csproj" />
    <ProjectReference Include="../SessionDock.Rdp.Windows/SessionDock.Rdp.Windows.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Content Include="../../artifacts/interop/Interop.MSTSCLib.dll" Condition="Exists('../../artifacts/interop/Interop.MSTSCLib.dll')">
      <Link>Interop.MSTSCLib.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
